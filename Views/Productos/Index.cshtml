@model IEnumerable<TechSolutions.Models.Producto>

@{
    ViewData["Title"] = "Inventario";
    var msg = TempData["Mensaje"] as string;
}

<h1>@ViewData["Title"]</h1>

@if (!string.IsNullOrEmpty(msg))
{
    <div class="alert alert-info" role="alert">
        @msg
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title">Buscar producto</h5>
                <form asp-action="BuscarProd" method="post" class="row g-2">
                    <div class="col-9">
                        <input id="nombre" name="nombre" type="text" class="form-control" placeholder="Nombre del producto" />
                    </div>
                    <div class="col-3 d-grid">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-search me-2"></i>Buscar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6 d-flex align-items-center">
        <div class="w-100">
            <a class="btn btn-success w-100" asp-controller="Productos" asp-action="Create">
                <i class="bi bi-cart-plus me-2"></i>Registrar producto
            </a>
        </div>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <p class="lead">El inventario se encuentra actualmente vacío</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-tech">
            <thead>
                <tr>
                    <th>Identificador</th>
                    <th>Nombre</th>
                    <th>Precio</th>
                    <th>Stock</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.IdProd</td>
                        <td>@r.Nombre</td>
                        <td>₡ @r.Precio</td>
                        <td>@r.Stock</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row g-4 mt-3">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">Actualizar inventario</h5>
                    <form asp-action="Edit" method="get" class="row g-2">
                        <div class="col-8">
                            <input id="ActualizarProd" name="IdProd" type="text" class="form-control" placeholder="Identificador de producto" />
                        </div>
                        <div class="col-4 d-grid">
                            <button type="submit" class="btn btn-outline-warning"><i class="bi bi-pencil me-2"></i>Actualizar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">Eliminar producto</h5>
                    <form asp-action="Delete" method="post" class="row g-2">
                        <div class="col-8">
                            <input id="EliminarProd" name="IdProd" type="text" class="form-control" placeholder="Identificador de producto" />
                        </div>
                        <div class="col-4 d-grid">
                            <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash-fill me-2"></i>Eliminar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-3">
        <div class="col-sm-6 col-md-3 d-grid">
            <a class="btn btn-secondary" asp-action="OrderP"><i class="bi bi-sort-numeric-down me-2"></i>Ordenar por precio</a>
        </div>
        <div class="col-sm-6 col-md-3 d-grid">
            <a class="btn btn-secondary" asp-action="AvgPrecio"><i class="bi bi-calculator me-2"></i>Promedio de precios</a>
        </div>
        <div class="col-sm-6 col-md-3 d-grid">
            <a class="btn btn-secondary" asp-action="ValInventario"><i class="bi bi-graph-up me-2"></i>Valor de inventario</a>
        </div>
        <div class="col-sm-6 col-md-3 d-grid">
            <a class="btn btn-secondary" asp-action="ReStock"><i class="bi bi-exclamation-circle me-2"></i>Stock crítico</a>
        </div>
    </div>
}