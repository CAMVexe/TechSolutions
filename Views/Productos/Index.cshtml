@model IEnumerable<TechSolutions.Models.Producto>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Inventario de Productos";
    var msg = TempData["Mensaje"] as string;
}

<h1>@ViewData["Title"]</h1>

@if (!string.IsNullOrEmpty(msg))
{
    <div class='alert alert-@TempData["Tipo"]'>
        @msg
    </div>
}

<form method="get" asp-action="Index" class="mb-3">
    <input type="text" name="searchString" placeholder="Buscar producto por nombre..." class="form-control" value="@Context.Request.Query["searchString"]" />
    <button type="submit" class="btn btn-primary mt-2">Buscar</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Mostrar todos</a>
</form>

<a asp-controller="Productos" asp-action="Create" class="btn btn-success mb-3">Agregar Producto</a>

@if (!Model.Any())
{
    <p>No hay personas registradas aun</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID Producto</th>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdProd</td>
                    <td>@item.Nombre</td>
                    <td>@item.Precio</td>
                    <td>@item.Stock</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.IdProd" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.IdProd" class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-action="Estadisticas" class="btn btn-info">Ver Estadísticas</a>
}
