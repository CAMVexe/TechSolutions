@model IEnumerable<TechSolutions.Models.Producto>

﻿@{
    ViewData["Title"] = "Inventario";
    var msg = TempData["Mensaje"] as string;
}

<h1>@ViewData["Title"]</h1>

@if (!string.IsNullOrEmpty(msg))
{
    <div class="alert alert-info" role="alert">
        @msg
    </div>
}


<div class="col-md-6">
    <h3>Buscar producto</h3>
    <form asp-action="BuscarProd" method="post">
        <div class="mb-3">
            <label for="nombre">Nombre</label>
            <input id="nombre" name="nombre" type="text" class="form-control" placeholder="Ingrese el nombre del producto que desea buscar" />
        </div>
        <button type="submit" class="btn btn-success">Buscar</button>
        <a class="btn btn-secondary" asp-action="Index">Volver</a>
    </form>
</div>

<p>
    <a class="btn btn-primary" asp-controller="Productos" asp-action="Create">
        <i class="bi bi-person-plus me-2"></i>Registrar producto
    </a>
</p>

@if (!Model.Any())
{
    <p>El inventario se encuentra actualmente vacío</p>
}
else
{
    <table class="table table-dark table-striped">
        <thead>
            <tr>
                <th>Identificador</th>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Stock</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.IdProd</td>
                    <td>@r.Nombre</td>
                    <td>@r.Precio</td>
                    <td>@r.Stock</td>
                </tr>
            }
        </tbody>
    </table>

    <br />
    <hr />
    <br />

    // Formularios para actualizar y eliminar productos
    <div class="col-md-6">
        <h3>Actualizar inventario</h3>
        <form asp-action="Edit" method="get">
            <div class="mb-3">
                <label for="ActualizarProd">IdProd</label>
                <input id="ActualizarProd" name="IdProd" type="text" class="form-control" placeholder="Identificador de producto" />
            </div>
            <button type="submit" class="btn btn-success"><i class="bi bi-pencil me-2"></i>Actualizar</button>
        </form>
    </div>

    <div class="col-md-6">
        <h3>Eliminar producto del inventario</h3>
        <form asp-action="Delete" method="post">
            <div class="mb-3">
                <label for="EliminarProd">IdProd</label>
                <input id="EliminarProd" name="IdProd" type="text" class="form-control" placeholder="Identificador de producto" />
            </div>
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-2"></i>Eliminar</button>
        </form>
    </div>

    <br />
    <hr />
    <br />

    <div class="col-md-6 d-flex align-items-center">
        <a class="btn btn-secondary w-100" asp-action="OrderP"><i class="bi bi-sort-alpha-down me-2"></i>Ordenar por precio</a>
    </div>

    <div class="col-md-6 d-flex align-items-center">
        <a class="btn btn-secondary w-100" asp-action="AvgPrecio"><i class="bi bi-bar-chart-line me-2"></i>Promedio de precios</a>
    </div>

    <div class="col-md-6 d-flex align-items-center">
        <a class="btn btn-secondary w-100" asp-action="ValInventario"><i class="bi bi-bar-chart-line me-2"></i>Valor de inventario</a>
    </div>

    <div class="col-md-6 d-flex align-items-center">
        <a class="btn btn-secondary w-100" asp-action="ReStock"><i class="bi bi-bar-chart-line me-2"></i>Stock critico</a>
    </div>
}